<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 每日 03:40（本地时间）备份账本、Temporal 与 Keycloak，并镜像到 iCloud Drive。由 infra/launchd/deploy.sh 安装。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cmap.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__ROOT__/current/infra/launchd/cmap-backup.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__/current</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>40</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__ROOT__/logs/backup.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/logs/backup.err.log</string>
</dict>
</plist>
