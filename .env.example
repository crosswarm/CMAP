# 复制为 .env 后按需调整。.env 已被 .gitignore 排除，绝不入库。

# ---------------------------------------------------------------- 代理隔离
# 必填。本机 http_proxy/https_proxy 指向 Surge (127.0.0.1:6152)，
# 若不排除 localhost，Surge 会拦截本地端口并返回 HTTP 200 + HTML 错误页，
# 导致客户端无限等待——表现为静默挂起，无日志无报错。
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1

# -------------------------------------------------------------- Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cmap-main

# 首次 docker compose 拉取后，把实际版本填在这里钉住，
# 避免 latest 漂移导致 Workflow 重放行为变化。
# TEMPORAL_VERSION=
# TEMPORAL_UI_VERSION=

# ------------------------------------------------------------ PostgreSQL
DATABASE_URL=postgres://temporal:temporal@localhost:5433/temporal

# Task Ledger 复用同一 PostgreSQL 实例，但用独立库 cmap——与 Temporal 自身
# 的表分开，清 Temporal 数据时不会连账本一起清掉。
CMAP_DATABASE_URL=postgres://temporal:temporal@localhost:5433/cmap
# 表所在 schema。生产用 public；测试与冒烟用独立 schema 隔离。
CMAP_DB_SCHEMA=public

# ------------------------------------------------------------- 控制面 API
# 仅监听 127.0.0.1。P4 接入 OIDC 前，这个端口是无认证的账本读写口。
CMAP_API_PORT=8787
# 请求上下文租户，P4 后改为从令牌解析。跨租户请求一律 404。
CMAP_TENANT=team-ycc

# runner 工作区。每个任务分一个子目录，Agent 在其中干活并写证据。
# 产物不入库（.gitignore 已排除）。
CMAP_WORK_ROOT=./.cmap-work

# ---------------------------------------------------------------- Runner
# runner 身份与准入策略。默认拒绝、白名单放行——
# 别人派发的任务不能默认在本机执行。
RUNNER_ID=local-dev
RUNNER_TENANT=team-ycc
RUNNER_ALLOWED_TENANTS=team-ycc
RUNNER_ALLOWED_OWNERS=crosswarm
RUNNER_MAX_RISK=read-sensitive

# ----------------------------------------------------------------- Codex
CODEX_BIN=codex
# 跨租户任务必须覆盖为受限档：本机 codex 默认是
# danger-full-access + approval_policy=never，直接暴露等于交出机器。
CODEX_SANDBOX=workspace-write

# --------------------------------------------------------------- Artifact
# P0 阶段映射到本地目录，P4 换 S3 兼容对象存储时不改调用方代码。
ARTIFACT_ROOT=./.artifacts
