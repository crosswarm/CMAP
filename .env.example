# 复制为 .env 后按需调整。.env 已被 .gitignore 排除，绝不入库。

# ---------------------------------------------------------------- 代理隔离
# 必填。本机 http_proxy/https_proxy 指向 Surge (127.0.0.1:6152)，
# 若不排除 localhost，Surge 会拦截本地端口并返回 HTTP 200 + HTML 错误页，
# 导致客户端无限等待——表现为静默挂起，无日志无报错。
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1

# -------------------------------------------------------------- Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cmap-main

# 首次 docker compose 拉取后，把实际版本填在这里钉住，
# 避免 latest 漂移导致 Workflow 重放行为变化。
# TEMPORAL_VERSION=
# TEMPORAL_UI_VERSION=

# ------------------------------------------------------------ PostgreSQL
DATABASE_URL=postgres://temporal:temporal@localhost:5433/temporal

# Task Ledger 复用同一 PostgreSQL 实例，但用独立库 cmap——与 Temporal 自身
# 的表分开，清 Temporal 数据时不会连账本一起清掉。
CMAP_DATABASE_URL=postgres://temporal:temporal@localhost:5433/cmap
# 表所在 schema。生产用 public；测试与冒烟用独立 schema 隔离。
CMAP_DB_SCHEMA=public

# ------------------------------------------------------------- 控制面 API
# 仅监听 127.0.0.1。P4 接入 OIDC 前，这个端口是无认证的账本读写口。
CMAP_API_PORT=8787
# 请求上下文租户，P4 后改为从令牌解析。跨租户请求一律 404。
CMAP_TENANT=team-ycc
# 本机创建 Mission 的归属，由控制面填入；不是已认证的 OIDC 身份。
CMAP_OWNER=local-operator
# OIDC 模式（docs/identity.md）：三项同时配置才生效，只配一部分拒绝启动。
# 配置后 tenant/owner/角色取自 Bearer JWT，上面两项与本机 Host 限制不再生效。
# 下面是开发 Keycloak（compose --profile auth）的值；WebUI 构建时另需
# VITE_CMAP_OIDC_ISSUER 与 VITE_CMAP_OIDC_CLIENT_ID=cmap-web。
# CMAP_OIDC_ISSUER=http://localhost:8180/realms/cmap
# CMAP_OIDC_AUDIENCE=cmap-api
# CMAP_OIDC_JWKS_URL=http://localhost:8180/realms/cmap/protocol/openid-connect/certs
# 经反向代理对外时的公网 Origin（仅 OIDC 模式可用），例如：
# CMAP_PUBLIC_ORIGIN=https://cmap.spux.cn

# runner 工作区。每个任务分一个子目录，Agent 在其中干活并写证据。
# 产物不入库（.gitignore 已排除）。
CMAP_WORK_ROOT=./.cmap-work

# ---------------------------------------------------------------- Memross
# Mission 带 memory 字段时，首个任务派发前从 Memross 检索并冻结记忆快照。
# 令牌是 Memross 只读 actor（node scripts/memory.mjs add-actor 生成），不入库；
# 未配置而 Mission 要求记忆时失败关闭。
MEMROSS_URL=http://127.0.0.1:19092
MEMROSS_TOKEN=

# ---------------------------------------------------------------- Runner
# runner 身份与准入策略。默认拒绝、白名单放行——
# 别人派发的任务不能默认在本机执行。
RUNNER_ID=local-dev
RUNNER_TENANT=team-ycc
RUNNER_ALLOWED_TENANTS=team-ycc
RUNNER_ALLOWED_OWNERS=local-operator
RUNNER_ALLOWED_CAPABILITIES=code.analyze
# 三个白名单变量必须存在；显式空值表示 deny-all，不从任务或 CMAP_* 自动授权。
# RUNNER_HOST 默认取本机 hostname；这些本地标签不是远程身份认证。
RUNNER_MAX_RISK=read-sensitive

# ----------------------------------------------------------------- Codex
CODEX_BIN=codex
# 跨租户任务必须覆盖为受限档：本机 codex 默认是
# danger-full-access + approval_policy=never，直接暴露等于交出机器。
CODEX_SANDBOX=workspace-write

# --------------------------------------------------------------- Artifact
# P0 阶段映射到本地目录，P4 换 S3 兼容对象存储时不改调用方代码。
ARTIFACT_ROOT=./.artifacts

# 本机 Adapter 注册顺序；默认保持 Codex。Kimi 当前仅支持 macOS + 已登录的 Kimi Code OAuth。
# 多候选只在启动前按能力/风险/健康选择，启动确认不明时不自动换 Agent。
CMAP_AGENTS=codex
# 示例：CMAP_AGENTS=kimi,codex
# Mission 累计 tokens 超过该值时写一条 MISSION_COST_ALERT 事件（只告警，不阻断）；不设置则不检查。
# CMAP_MISSION_COST_ALERT_TOKENS=2000000

# --------------------------------------------------------------- Jev 影子模式（ADR-0007）
# 指向真人签发的委托策略（delegation-policy.v1，文件不得对 group/other 可写）。
# 不设置则审批闸口完全不调用 Jev。影子模式只记录 Jev 决定，不改审批。
# CMAP_DELEGATION_POLICY_FILE=/Users/<you>/.cmap/delegation-policy.json
# 本机网络需经代理访问 Jev 时，Node 的 fetch 默认不读 HTTPS_PROXY，须打开：
# NODE_USE_ENV_PROXY=1
