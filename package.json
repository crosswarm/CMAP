{
  "name": "cmap",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Control Plane — 跨主机多 Agent 统一调度、协作与任务管理平台",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#domain-model": "./packages/domain-model/src/index.ts",
    "#adapter-sdk": "./packages/adapter-sdk/src/index.ts"
  },
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/contract/*.test.mjs tests/tooling/*.test.mjs tests/domain/memory-store.test.ts tests/domain/task-state.test.ts tests/domain/evidence-pack.test.ts tests/domain/no-progress.test.ts",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "test:domain": "node --test tests/domain/memory-store.test.ts tests/domain/task-state.test.ts tests/domain/evidence-pack.test.ts tests/domain/no-progress.test.ts",
    "check": "npm run typecheck && npm test && npm run test:api",
    "test:pg": "node --test --test-concurrency=1 tests/domain/pg-store.test.ts",
    "test:store": "node --test --test-concurrency=1 tests/domain/memory-store.test.ts tests/domain/pg-store.test.ts",
    "test:workflow": "node --test --test-concurrency=1 tests/workflow/*.test.ts",
    "test:api": "node --test --test-concurrency=1 tests/api/*.test.ts"
  },
  "devDependencies": {
    "@temporalio/activity": "^1.21.1",
    "@temporalio/client": "^1.21.1",
    "@temporalio/worker": "^1.21.1",
    "@temporalio/workflow": "^1.21.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
