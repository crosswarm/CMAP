{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmap.local/schemas/quota-handoff.v1.schema.json",
  "title": "QuotaHandoffV1",
  "description": "QUOTA_HANDOFF 事件的 payload（ADR-0009 §3）。dag/v1 节点任务以 QUOTA_EXHAUSTED 结束时，控制面派生同一轮次的续接任务（supersedes_task_id 指向原任务），不消耗返工预算；每个节点的续接次数有上限（默认 2），超限节点升级给人且不写本事件。续接任务派发时排除 excluded_agents（原 Agent 及本链路此前触顶的 Agent）。只读级（read-meta、read-sensitive）新开工作区；有写副作用的级别（controlled、mutating）必须先有 exit_proof 证明原 Agent 已退出，再以原工作区快照作为冻结输入（snapshot），不共享可写工作区；其审批绑定新任务、重新走闸口。幂等键 quota-handoff:<from_task_id>。只存标识、枚举与哈希，不存工作区内容或 Agent 输出。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "node_id", "from_task_id", "to_task_id", "handoff_index", "from_agent", "excluded_agents", "risk_level", "workspace", "snapshot", "exit_proof"],
  "properties": {
    "schema": { "const": "cmap/quota-handoff/v1" },
    "node_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "from_task_id": { "$ref": "#/$defs/identifier" },
    "to_task_id": { "$ref": "#/$defs/identifier" },
    "handoff_index": { "type": "integer", "minimum": 1, "description": "本节点第几次续接，从 1 起。" },
    "from_agent": { "$ref": "#/$defs/identifier" },
    "excluded_agents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "risk_level": { "enum": ["read-meta", "read-sensitive", "controlled", "mutating"] },
    "workspace": { "enum": ["fresh", "snapshot"] },
    "snapshot": {
      "description": "原工作区快照（不含 inputs/ 与符号链接），登记为续接任务名下的 workspace_snapshot 冻结输入，并在新工作区解包。",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "sha256", "size_bytes", "file_count"],
          "properties": {
            "artifact_id": { "$ref": "#/$defs/identifier" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "size_bytes": { "type": "integer", "minimum": 0 },
            "file_count": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "exit_proof": {
      "description": "原 Agent 已退出的证据：结果已落账（运行记录完结）且 Adapter 观测到终态（进程组已不在）。",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result_recorded", "terminal_observed", "status", "observed_at"],
          "properties": {
            "result_recorded": { "const": true },
            "terminal_observed": { "const": true },
            "status": { "enum": ["completed", "failed", "canceled"] },
            "observed_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "risk_level": { "enum": ["controlled", "mutating"] } }, "required": ["risk_level"] },
      "then": { "properties": { "workspace": { "const": "snapshot" }, "snapshot": { "type": "object" }, "exit_proof": { "type": "object" } } },
      "else": { "properties": { "workspace": { "const": "fresh" }, "snapshot": { "type": "null" } } }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "[\\s*]" } }
  }
}
