{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmap.local/schemas/dispatch-permit/v1",
  "title": "DispatchPermitV1",
  "description": "Opaque cmap1 token payload signed with Ed25519 over ASCII cmap1. plus original UTF8 payload bytes. Binds exact Node JSON.stringify TaskEnvelope SHA256 and managed runner/adapter audience. Integer epoch seconds; issued_at <= not_before < expires_at, lifetime <=60 seconds, issued_at/not_before <= trusted now < expires_at. Managed adapter verifies before preparation and again before provider spawn/send. Denial is PERMIT_INVALID post-intent admission receipt, preserving binding without a TaskResult. Tokens and private keys are never logged, persisted, or passed to provider children. Local ephemeral trust does not authenticate another host.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kid",
    "issuer",
    "audience",
    "runner_id",
    "mission_id",
    "task_id",
    "revision",
    "idempotency_key",
    "envelope_sha256",
    "issued_at",
    "not_before",
    "expires_at",
    "nonce"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "cmap/dispatch-permit/v1"
    },
    "kid": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s*]+$"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s*]+$"
    },
    "runner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s*]+$"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s*]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s*]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "envelope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "not_before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    }
  }
}
