{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmap.local/schemas/review-application/v1",
  "title": "ReviewApplicationV1",
  "description": "Private ledger receipt payload. One immutable application per Task; round and canonical semantic input SHA bind decision/progress. Missing progress normalizes to null; object keys and failedCriteriaIds sort, other array order remains significant. Events contain no raw decisions, focus text or prompts. Intent precedes review/child/state writes; completion is appended only after exact child/source/Mission proof. Same idempotency key with changed semantic event fields conflicts, timestamps and generated IDs do not.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "round",
    "input_sha256",
    "review_id",
    "output"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "cmap/review-application/v1"
    },
    "phase": {
      "type": "string",
      "enum": [
        "intent",
        "complete"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "followupTaskIds"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "accept",
            "rework",
            "escalated"
          ]
        },
        "followupTaskIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "escalationReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "output": {
            "properties": {
              "outcome": {
                "const": "rework"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "properties": {
              "followupTaskIds": {
                "minItems": 1
              }
            },
            "not": {
              "required": [
                "escalationReason"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "properties": {
              "followupTaskIds": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "output": {
            "properties": {
              "outcome": {
                "const": "escalated"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "required": [
              "escalationReason"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "not": {
              "required": [
                "escalationReason"
              ]
            }
          }
        }
      }
    }
  ]
}
