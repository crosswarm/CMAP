{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmap.local/schemas/review-application/v1",
  "title": "ReviewApplicationV1",
  "description": "Private ledger receipt payload. One immutable application per Task; round and canonical semantic input SHA bind decision/progress. Missing progress normalizes to null; object keys and failedCriteriaIds sort, other array order remains significant. Events contain no raw decisions, focus text or prompts. Intent precedes review/child/state writes; completion is appended only after exact child/source/Mission proof. Same idempotency key with changed semantic event fields conflicts, timestamps and generated IDs do not.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "round",
    "input_sha256",
    "review_id",
    "output"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "cmap/review-application/v1"
    },
    "phase": {
      "type": "string",
      "enum": [
        "intent",
        "complete"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "followup_format": {
      "type": "integer",
      "enum": [2, 3],
      "description": "Absent means legacy child template1. Format2 freezes the descriptor matrix into the canonical input hash; format3 (new applications) additionally copies the decision's failed criteria and focus into each child's inputs.previous_attempt. Intent and completion must agree. Never reinterpret old child rows."
    },
    "followup_inputs": {
      "type": "array",
      "description": "Format2 normalized artifact descriptors per child, in declared order. Exactly one entry per rework child and none for accept/escalated, checked at runtime. No source paths, bytes, goal or parameter text. Retries reconstruct children from this matrix; dispatch separately verifies current availability and permissions.",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "source_task_id", "role", "uri", "sha256"],
          "properties": {
            "artifact_id": { "type": "string", "minLength": 1 },
            "source_task_id": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "uri": { "type": "string", "pattern": "^inputs/review/[a-f0-9]{64}/payload$" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "followupTaskIds"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "accept",
            "rework",
            "escalated"
          ]
        },
        "followupTaskIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "escalationReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["followup_format"] },
      "then": { "required": ["followup_inputs"] },
      "else": { "not": { "required": ["followup_inputs"] } }
    },
    {
      "if": {
        "properties": {
          "output": {
            "properties": {
              "outcome": {
                "const": "rework"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "properties": {
              "followupTaskIds": {
                "minItems": 1
              }
            },
            "not": {
              "required": [
                "escalationReason"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "properties": {
              "followupTaskIds": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "output": {
            "properties": {
              "outcome": {
                "const": "escalated"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "required": [
              "escalationReason"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "not": {
              "required": [
                "escalationReason"
              ]
            }
          }
        }
      }
    }
  ]
}
