{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmap.local/schemas/mission-query/v1",
  "title": "MissionQueryV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant"],
  "properties": {
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "terminal_limit": {
      "description": "省略表示不限；给出时返回全部非终态 Mission，加最近创建的至多 N 条终态 Mission（COMPLETED/ESCALATED/FAILED/CANCELED）。",
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    }
  }
}
